{
	"extends": "@sanity/tsconfig/strictest",
	"compilerOptions": {
		"rootDir": ".",
		"jsx": "preserve",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["node"],
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["src", "package.config.ts"],
	"exclude": ["dist", "node_modules"]
}
