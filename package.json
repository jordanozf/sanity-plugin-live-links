{
	"name": "sanity-plugin-live-links",
	"version": "0.1.0",
	"description": "Sanity Studio panel for opening and copying localized live site URLs",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"screenshot-example.png",
		"LICENSE"
	],
	"scripts": {
		"build": "pkg-utils build --strict --check --clean",
		"watch": "pkg-utils watch --strict",
		"link-watch": "plugin-kit link-watch",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"sanityPlugin": {
		"verifyPackage": {
			"scripts": false,
			"oxfmt": false,
			"oxlint": false
		}
	},
	"browserslist": "extends @sanity/browserslist-config",
	"peerDependencies": {
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19",
		"sanity": "^5 || ^6.0.0-0"
	},
	"devDependencies": {
		"@sanity/browserslist-config": "^1.0.5",
		"@sanity/icons": "^5.2.2",
		"@sanity/pkg-utils": "^12.3.4",
		"@sanity/plugin-kit": "^10.0.10",
		"@sanity/tsconfig": "^2.2.1",
		"@sanity/ui": "^4.2.6",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.2.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "^6.16.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20.19 <22 || >=22.12"
	},
	"keywords": [
		"sanity",
		"sanity-plugin",
		"studio",
		"i18n",
		"localization"
	],
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
